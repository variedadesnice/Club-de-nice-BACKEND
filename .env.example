SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional — habilita caché (analytics) y rate limiting (login/register).
# Si se deja vacío, ambos quedan deshabilitados sin afectar el resto de la app.
REDIS_URL=

RESEND_API_KEY=re_xxxxxxxxxxxx
FROM_EMAIL=El Club de Nice <hola@tudominio.com>
APP_URL=https://tudominio.com
APP_NAME=El Club de Nice

# SendHook — verificación automática de pagos móviles (Pago Móvil / Binance P2P).
# Si SENDHOOK_API_URL o SENDHOOK_API_KEY quedan vacíos, la verificación
# automática se omite y todos los pagos quedan 'pending' para revisión manual.
SENDHOOK_API_URL=https://tu-backend-sendhook.vercel.app
SENDHOOK_API_KEY=
# Secreto whsec_... para validar la firma de los webhooks entrantes. Se pide
# al admin de SendHook junto con el alta de esta URL pública:
#   POST https://tu-backend/api/webhooks/sendhook
# Sin él, el receptor responde 503 y sólo funcionan los reintentos de respaldo.
SENDHOOK_WEBHOOK_SECRET=
